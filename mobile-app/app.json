{
  "expo": {
    "name": "SlimGuard",
    "slug": "slim-guard",
    "version": "1.0.0",
    "scheme": "slimguard",
    "orientation": "portrait",
    "icon": "./assets/icon-brand.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.slimguard.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.slimguard.app",
      "adaptiveIcon": {
        "backgroundColor": "#2F6F52",
        "foregroundImage": "./assets/adaptive-foreground-brand.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SlimGuard 需要读取你选择的饮食照片，以便减脂教练帮助分析。",
          "cameraPermission": "SlimGuard 需要使用相机拍摄饮食照片，以便减脂教练帮助分析。",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-foreground-brand.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F6F3EC"
        }
      ],
      "expo-font"
    ]
  }
}
