{
  "expo": {
    "name": "称小二",
    "slug": "slim-guard",
    "version": "1.0.0",
    "scheme": "slimguard",
    "orientation": "portrait",
    "icon": "./assets/brand/cheng-xiao-er-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.slimguard.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.slimguard.app",
      "adaptiveIcon": {
        "backgroundColor": "#F3BE96",
        "foregroundImage": "./assets/brand/cheng-xiao-er-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/cheng-xiao-er-icon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "称小二需要读取你选择的饮食照片，以便减重教练帮助分析。",
          "cameraPermission": "称小二需要使用相机拍摄饮食照片，以便减重教练帮助分析。",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/cheng-xiao-er-foreground.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#F3BE96"
        }
      ],
      "expo-font",
      "expo-status-bar"
    ]
  }
}
