# One server, one runtime configuration. Copy this file to deploy/.env.server,
# keep it chmod 600, and never commit the real file.

# Deployment identity and host-only ports
PUBLIC_BASE_URL=https://enceladus.online
APP_HOST_PORT=18083
ADMIN_WEB_HOST_PORT=18084
SLIM_GUARD_APP_IMAGE_REPOSITORY=slim-guard/app
SLIM_GUARD_ADMIN_IMAGE_REPOSITORY=slim-guard/admin-web
MEM0_IMAGE=slim-guard/mem0:2.0.19-sg1
MEM0AI_VERSION=2.0.19
MEM0_SOURCE_DIR=/home/ubuntu/mem0/server
BACKUP_DIR=/home/ubuntu/backups/slim-guard
BACKUP_RETENTION_DAYS=14

# Existing volumes can be reused during the first cutover. New installations
# should use the clean default names shown here.
SLIM_GUARD_DB_VOLUME=slim-guard-prod-db
MEM0_DB_VOLUME=slim-guard-prod-mem0-db
MEM0_HISTORY_VOLUME=slim-guard-prod-mem0-history

# SlimGuard PostgreSQL (generate passwords with: openssl rand -hex 32)
SLIM_GUARD_POSTGRES_DB=slim_guard
SLIM_GUARD_POSTGRES_USER=slim_guard
SLIM_GUARD_POSTGRES_PASSWORD=CHANGE_ME

# Mem0 PostgreSQL / pgvector
MEM0_POSTGRES_DB=postgres
MEM0_POSTGRES_USER=postgres
MEM0_POSTGRES_PASSWORD=CHANGE_ME
MEM0_POSTGRES_COLLECTION_NAME=memories

# Mem0 service authentication. SlimGuard uses the same MEM0_API_KEY when calling
# the internal service; Mem0 is never published on a host port.
MEM0_API_KEY=CHANGE_ME
MEM0_JWT_SECRET=CHANGE_ME
MEM0_TELEMETRY=false
MEM0_REQUEST_LOG_RETENTION_DAYS=30
MEM0_LLM_MODEL=glm-5.2
MEM0_EMBEDDER_MODEL=embedding-3
MEM0_EMBEDDING_DIMS=1024

# SlimGuard application
APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
LOG_LEVEL=INFO
AGENT_RUNTIME_MODE=harness
REPLY_DELIVERY_MODE=automatic

# Model provider shared by SlimGuard and the persisted Mem0 configuration.
ZHIPU_API_KEY=CHANGE_ME
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_TEXT_MODEL=glm-5.2
ZHIPU_VISION_MODEL=glm-5v-turbo
ZHIPU_HTTP_TIMEOUT_SECONDS=45
ZHIPU_MAX_OUTPUT_TOKENS=1024
AGENT_REPLY_MAX_CHARS=1500

# Admin authentication is owned by FastAPI, not Nginx.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
ADMIN_SESSION_TTL_HOURS=12

# Mobile test login. Keep development mode while these accounts are enabled.
MOBILE_API_ENABLED=true
MOBILE_AUTH_SECRET=CHANGE_ME
MOBILE_ACCESS_TOKEN_TTL_MINUTES=15
MOBILE_REFRESH_TOKEN_TTL_DAYS=30
MOBILE_OTP_TTL_SECONDS=300
MOBILE_OTP_RESEND_SECONDS=60
MOBILE_OTP_HOURLY_LIMIT=5
MOBILE_DEV_OTP_ENABLED=true
MOBILE_TEST_ACCOUNTS_ENABLED=true
MOBILE_TEST_ACCOUNT_PASSWORD=123456
MOBILE_SMS_WEBHOOK_URL=
MOBILE_SMS_WEBHOOK_TOKEN=
MOBILE_WECOM_BINDING_TTL_MINUTES=10

# WeCom
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com
WECOM_CORP_ID=
WECOM_KF_SECRET=
WECOM_OPEN_KF_ID=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=
WECOM_HUMAN_IDLE_TIMEOUT_SECONDS=600
WECOM_SESSION_WATCHDOG_INTERVAL_SECONDS=30
WECOM_OUTBOX_RECOVERY_INTERVAL_SECONDS=30
WECOM_OUTBOX_SEND_STALE_SECONDS=120
WECOM_CUSTOMER_PROFILE_REFRESH_SECONDS=86400
WECOM_MEDIA_MAX_BYTES=10485760
WECOM_HUMAN_TIMEOUT_MESSAGE=人工服务暂时没有响应，已结束人工接待。请再发送一次刚才的内容，SlimGuard 减脂助手会继续为你服务。

# Memory and Harness
MEMORY_PRELOAD_MAX_FACTS=30
MEMORY_HEALTH_REVIEW_DAYS=180
MEMORY_RECENT_TURN_COUNT=3
MEMORY_RECENT_DIALOGUE_MAX_CHARS=1500
MEMORY_RECENT_IMAGE_COUNT=3
MEMORY_HANDOFF_TTL_DAYS=14
MEMORY_INGESTION_ENABLED=true
MEMORY_INGESTION_HISTORY_COUNT=20
MEMORY_INGESTION_HISTORY_MAX_CHARS=6000
MEMORY_RECALL_ENABLED=true
MEMORY_RECALL_SEARCH_LIMIT=12
MEMORY_RECALL_MAX_SELECTED=8
MEMORY_SEMANTIC_ENABLED=true
MEM0_NAMESPACE=slim_guard
MEM0_HTTP_TIMEOUT_SECONDS=10
MEMORY_INDEX_SYNC_INTERVAL_SECONDS=5
MEMORY_INDEX_SYNC_BATCH_SIZE=20
MEMORY_INDEX_SYNC_MAX_ATTEMPTS=10
AGENT_TRANSCRIPT_BODY_RETENTION_DAYS=30
MEMORY_REVOKED_VALUE_RETENTION_DAYS=30
MEMORY_MAINTENANCE_INTERVAL_SECONDS=21600
AGENT_IMAGE_RETENTION_SECONDS=604800
ASSET_MAINTENANCE_INTERVAL_SECONDS=21600

# Routine scheduler and proactive messaging
ROUTINE_SCHEDULER_ENABLED=true
ROUTINE_SCHEDULER_INTERVAL_SECONDS=30
ROUTINE_JOB_LEASE_SECONDS=120
ROUTINE_SEND_RETRY_SECONDS=120
ROUTINE_MAX_LATENESS_SECONDS=7200
ROUTINE_AGENT_TIMEOUT_SECONDS=45
ROUTINE_MAX_ATTEMPTS=3
WECOM_PROACTIVE_ACTIVE_WINDOW_HOURS=48
WECOM_PROACTIVE_MAX_MESSAGES=3

AGENT_FALLBACK_REPLY_TEXT=抱歉，我刚才没有成功分析这条记录，请稍后再发一次。
