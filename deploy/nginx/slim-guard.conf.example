# Merge these locations into the existing HTTPS server block for your SlimGuard
# domain. Keep the real certificate paths managed by your current ACME/certbot setup.

server {
    listen 443 ssl http2;
    server_name slim-guard.example.com;

    ssl_certificate /etc/letsencrypt/live/slim-guard.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/slim-guard.example.com/privkey.pem;

    client_max_body_size 12m;

    location = /admin {
        return 301 /admin/;
    }

    location ^~ /admin/ {
        # Authentication is owned by the FastAPI backend. Nginx only serves the SPA.
        proxy_pass http://127.0.0.1:18084/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /api/admin/ {
        # Preserve the complete path. Cookies are forwarded by Nginx by default.
        proxy_pass http://127.0.0.1:18083;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /api/mobile/ {
        # Mobile access/refresh tokens are verified by FastAPI. Nginx does not
        # keep another credential or authentication policy.
        proxy_pass http://127.0.0.1:18083;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }

    # These existing public application routes remain independent of admin sessions.
    location /callbacks/wecom/kf {
        proxy_pass http://127.0.0.1:18083;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /health/ {
        proxy_pass http://127.0.0.1:18083;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
